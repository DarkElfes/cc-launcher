{
  "name": "cc-launcher",
  "productName": "cc-launcher",
  "version": "0.6.0",
  "private": true,
  "description": "Projects-first desktop launcher for Claude Code with per-account profiles",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
